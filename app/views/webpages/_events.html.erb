  <div id="newsCarousel" class="carousel" role="region" aria-roledescription="carousel" aria-label="Featured Events">
    <div id="newsCarouselItems" class="carousel-inner mx-3 pb-0" role="list">
    <% @featured_events.each_with_index do |event, i| %>
      <div class="carousel-item<%= " active" if i == 0 %>" role="listitem">
        <div class="card library-event">
          <%= link_to event_path(event.id) do %>
            <% event_image = event.rendered_image { event.show_image } %>
            <div class="item pb-4">
              <% if event_image %>
                <%= image_tag event_image, alt: image_alt_text(event), loading: "lazy", height: "252px", width: "420px" %>
              <% else %>
                <%= image_tag "T.png", alt: "Temple T Logo", loading: "lazy" %>
              <% end %>
            </div>
            <div class="card-body px-0">
              <div class="item-caption text-start mt-0">
                <h3><%= event.label.truncate(52) %></h3>
                <p class="card-text event-date">
                  <span class="d-block"><%= event.get_date %></span>
                  <%= event.set_times %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end if @featured_events.present? %>
    </div>
    <p class="visually-hidden carousel-status" role="status"></p>
    <button class="carousel-control-prev bg-transparent w-aut" type="button" aria-controls="newsCarouselItems">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next bg-transparent w-aut" type="button" aria-controls="newsCarouselItems">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
  </div>
  <div class="col-12 text-end px-0">
    <%= link_to "View all events", events_path, class: "view-all" %>
  </div>
