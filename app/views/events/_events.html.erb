<div class="row events">
<% @events_list.each do |listing| %>
  <% event = listing.respond_to?(:source) ? listing.source : listing %>
  <div class="col-12 col-md-6 col-lg-4 event">
    <div class="row mb-4 pe-2">
      <div class="col-12">
        <div class="event-image">
          <%= render_image(event, variant: :index) %>
          <p class="event-date">
            <%= event.card_date %>
          </p>
        </div>
      </div>
      <div class="col-12">
        <% if (location = event.card_location).present? %>
          <%= content_tag(:p, location, class: "event-card-location") %>
        <% end %>
        <%= link_to event.title.truncate(64), event, class: "event-title", target: "_top" %>
      </div>
    </div>
  </div>
<% end if @events_list.present? %>

<% unless @events_list.present? %>
<h3 class="mt-5 ml-3">
  <% if params[:date].present? %>
    <%= t("manifold.events.index.no_scheduled_events") %>, 
    <%= Date.parse(params[:date]).strftime("%m-%d-%Y") %>
  <% else %>
    <%= t("manifold.events.index.no_event_types") %> 
  <% end %>

</h3>
<% end %>

  <div class="col-12 text-end paginator">
    <%= paginate @events_list, :params => { anchor: "list" } if @events_list.present? %>
  </div>

</div>
