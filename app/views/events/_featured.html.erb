<% @featured_events.each do |event| %>
<div class="col-12 col-md-4 px-4 pb-4">
  <div class="featured-event">
    <div class="event-image">
      <%= render_image(event, variant: :index) %>
      <p class="event-date"><%= event_card_date(event) %></p>
    </div>
    <%= content_tag(:p, event_card_location(event), class: "event-card-location") if event_card_location(event).present? %>
    <%= link_to event.title.truncate(64), event, class: "event-title", target: "_top" %>
  </div>
</div>
<% end %>
