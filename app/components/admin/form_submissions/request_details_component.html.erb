<h2 class="section-title">Request Information</h2>
<div class="requests-list">
  <% requests.each_with_index do |request, index| %>
    <div class="request-item">
      <h3 class="request-number">Request <%= index + 1 %></h3>
      <div class="request-content">
        <dl class="attribute-list">
          <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :collection_title, surface: :admin) %></dt>
          <dd class="attribute-list__value"><%= request["collection_title"] %></dd>

          <% if av_request? %>
            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :identifier, surface: :admin) %></dt>
            <dd class="attribute-list__value"><%= request["identifier"] %></dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :notes, surface: :admin) %></dt>
            <dd class="attribute-list__value">
              <% if request["notes"].present? %>
                <%= simple_format(request["notes"]) %>
              <% else %>
                Not provided
              <% end %>
            </dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :format, surface: :admin) %></dt>
            <dd class="attribute-list__value">
              <%= format_label(request["format"]) %>
            </dd>
          <% else %>
            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :box, surface: :admin) %></dt>
            <dd class="attribute-list__value"><%= request["box"] %></dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :folder, surface: :admin) %></dt>
            <dd class="attribute-list__value"><%= request["folder"] %></dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :identifier, surface: :admin) %></dt>
            <dd class="attribute-list__value"><%= request["identifier"] %></dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :estimated_pages, surface: :admin) %></dt>
            <dd class="attribute-list__value"><%= request["estimated_pages"] %></dd>

            <dt class="attribute-list__key"><%= Form::RequestDefinition.field_label(@form_submission.form_type, :format, surface: :admin) %></dt>
            <dd class="attribute-list__value">
              <%= format_label(request["format"]) %>
            </dd>
          <% end %>
        </dl>
      </div>
    </div>
  <% end %>

  <% if requests.empty? %>
    <p class="no-requests">No requests specified.</p>
  <% end %>
</div>
