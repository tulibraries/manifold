  <div id="newsCarousel" class="carousel" role="region" aria-roledescription="carousel" aria-label="Featured Events">
    <div id="newsCarouselItems" class="carousel-inner mx-3 pb-0" role="list">
    <% @featured_events.each_with_index do |event, i| %>
      <div class="carousel-item<%= " active" if i == 0 %>" role="listitem">
        <div class="card library-event">
          <div class="event-image">
            <%= render_image(event, variant: :index) %>
            <p class="event-date"><%= event.card_date %></p>
          </div>
          <% if (location = event.card_location).present? %>
            <%= content_tag(:p, location, class: "event-card-location") %>
          <% end %>
          <h3 class="event-heading">
            <%= link_to event.title.truncate(64), event, class: "event-title", target: "_top" %>
          </h3>
        </div>
      </div>
    <% end if @featured_events.present? %>
    </div>
    <p class="visually-hidden carousel-status" role="status"></p>
    <button class="carousel-control-prev bg-transparent w-aut" type="button" aria-controls="newsCarouselItems">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next bg-transparent w-aut" type="button" aria-controls="newsCarouselItems">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
  </div>
  <div class="col-12 text-end px-0">
    <%= link_to "View all events", events_path, class: "view-all" %>
  </div>
